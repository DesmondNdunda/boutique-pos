# ---------- Database (Supabase PostgreSQL) ----------
# Supabase shared pooler for IPv4-only networks. Copy the exact URIs from
# Connect → ORM → Prisma. DATABASE_URL is transaction mode for app traffic;
# DIRECT_URL is session mode for Prisma migrations.
# Replace [YOUR-PASSWORD]; URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:5432/postgres"

# ---------- API ----------
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:5173"

# Session secret - generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"
COOKIE_DOMAIN="localhost"

# ---------- M-Pesa Daraja (Safaricom) ----------
# Create a Daraja sandbox app at https://developer.safaricom.co.ke.
# Copy its Consumer Key and Consumer Secret into your local .env (never commit them).
MPESA_ENV="sandbox"                 # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"            # Sandbox test shortcode; use your live Paybill/Till in production
MPESA_PASSKEY=""                    # Daraja Lipa Na M-Pesa Online passkey for this shortcode
MPESA_CALLBACK_URL="https://your-public-domain.example.com/api/payments/mpesa/callback"
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline" # CustomerBuyGoodsOnline for a configured Till
# ^ Must be a publicly reachable HTTPS URL. Use ngrok in local dev, e.g.:
#   ngrok http 4000  ->  MPESA_CALLBACK_URL=https://xxxx.ngrok-free.app/api/payments/mpesa/callback

# ---------- Storage (product images) ----------
# Using Supabase Storage bucket. Create a public bucket named "product-images".
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# ---------- Subscription billing (Stripe) ----------
# Configure recurring prices in Stripe and add their Price IDs here.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_BASIC_PRICE_ID=""
STRIPE_PRO_PRICE_ID=""
# Add https://<your-api-domain>/api/billing/webhook in Stripe for
# checkout.session.completed, customer.subscription.updated and
# customer.subscription.deleted events.

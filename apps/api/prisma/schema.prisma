generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum SubscriptionPlan {
  TRIAL
  BASIC
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  subscriptionPlan SubscriptionPlan   @default(TRIAL)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  stripeCustomerId String? @unique
  stripeSubscriptionId String? @unique
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  branches      Branch[]
  users         User[]
  products      Product[]
  categories    Category[]
  sales         Sale[]
  auditLogs     AuditLog[]
  stockMovements StockMovement[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  isMain         Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  inventory    Inventory[]
  sales        Sale[]

  @@index([organizationId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Users / Auth / RBAC
// ---------------------------------------------------------------------------

enum Role {
  OWNER
  MANAGER
  EMPLOYEE
}

model User {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  email          String
  passwordHash   String
  role           Role     @default(EMPLOYEE)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?       @relation(fields: [branchId], references: [id])
  sales        Sale[]
  stockMovements StockMovement[]
  auditLogs    AuditLog[]
  sessions     Session[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([organizationId, name])
  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String
  categoryId     String?
  name           String
  description    String?
  basePrice      Decimal  @db.Decimal(12, 2)
  imageUrl       String?
  hasVariants    Boolean  @default(true)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     Category?         @relation(fields: [categoryId], references: [id])
  variants     ProductVariant[]

  @@index([organizationId])
  @@map("products")
}

// A variant represents a specific sellable combination (size/color), or the
// product itself when hasVariants=false (a single "default" variant is created).
model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  size      String?  // e.g. "M" — null if not applicable
  color     String?  // e.g. "Black" — null if not applicable
  sku       String?  // optional, auto-generated if not supplied
  price     Decimal? @db.Decimal(12, 2) // overrides Product.basePrice if set
  createdAt DateTime @default(now())

  product        Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory      Inventory[]
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([productId, size, color])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// Inventory
// ---------------------------------------------------------------------------

model Inventory {
  id        String   @id @default(cuid())
  branchId  String
  variantId String
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([branchId, variantId])
  @@map("inventory")
}

enum StockMovementReason {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  TRANSFER
}

model StockMovement {
  id             String               @id @default(cuid())
  organizationId String
  branchId       String
  variantId      String
  userId         String
  reason         StockMovementReason
  quantityBefore Int
  quantityChange Int // positive = increase, negative = decrease
  quantityAfter  Int
  note           String?
  createdAt      DateTime             @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user         User           @relation(fields: [userId], references: [id])

  @@index([organizationId, branchId])
  @@index([variantId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Sales / Payments
// ---------------------------------------------------------------------------

enum SaleStatus {
  PENDING_PAYMENT
  COMPLETED
  CANCELED
  REFUNDED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELED
}

model Sale {
  id             String     @id @default(cuid())
  organizationId String
  branchId       String
  userId         String     // employee who made the sale
  status         SaleStatus @default(PENDING_PAYMENT)
  subtotal       Decimal    @db.Decimal(12, 2)
  total          Decimal    @db.Decimal(12, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  items        SaleItem[]
  payments     Payment[]

  @@index([organizationId, branchId])
  @@map("sales")
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  variantId String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  lineTotal Decimal @db.Decimal(12, 2)

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("sale_items")
}

model Payment {
  id            String        @id @default(cuid())
  saleId        String
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal       @db.Decimal(12, 2)
  mpesaCheckoutRequestId String?
  mpesaMerchantRequestId String?
  mpesaReceiptNumber     String?
  phoneNumber   String?
  rawCallback   Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([mpesaCheckoutRequestId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String   // e.g. "product.create", "inventory.restock", "sale.complete"
  entityType     String
  entityId       String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx --watch-path=src src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",

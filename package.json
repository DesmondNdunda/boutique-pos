{
  "name": "boutique-pos",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:api": "corepack pnpm --filter @boutique-pos/api dev",
    "dev:web": "corepack pnpm --filter @boutique-pos/web dev",
    "build": "corepack pnpm --dir apps/api build && corepack pnpm --dir apps/web build",
    "prisma:generate": "corepack pnpm --filter @boutique-pos/api prisma:generate",
    "prisma:migrate": "corepack pnpm --filter @boutique-pos/api prisma:migrate",
    "prisma:studio": "corepack pnpm --filter @boutique-pos/api prisma:studio",
    "seed": "corepack pnpm --filter @boutique-pos/api seed"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0"
}

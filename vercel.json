{
  "buildCommand": "corepack pnpm --filter @boutique-pos/web build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] },
    { "source": "/registerSW.js", "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://boutique-posapi-production.up.railway.app/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://boutique-posapi-production.up.railway.app/uploads/:path*" },
    { "source": "/(.*)", "destination": "/" }
  ]
}
